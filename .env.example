# Copy to .env and fill in. .env is gitignored.

# Postgres (docker compose service "db"; host port 5433 so it never collides with a local 5432)
POSTGRES_PASSWORD=change-me-admin
SHERPA_DB_HOST=localhost
SHERPA_DB_PORT=5433
SHERPA_DB_NAME=sherpa
# One password for the persona login roles (sherpa_head, sherpa_rm_south) and the app role (sherpa_app)
SHERPA_ROLE_PASSWORD=change-me-roles

# LLM backend: auto | anthropic | claude-cli | none
#   auto -> anthropic if ANTHROPIC_API_KEY is set, else claude-cli if `claude` is on PATH, else none (Explore mode only)
SHERPA_LLM_BACKEND=auto
ANTHROPIC_API_KEY=
SHERPA_PLANNER_MODEL=claude-opus-5-5
SHERPA_NARRATOR_MODEL=claude-sonnet-5-5
